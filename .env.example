# Sao chép thành .env trên mỗi máy và điền giá trị (spec F2). Không commit .env.
# Các URL (NODE_DB_URL, HQ_DB_URL, HQ_URL, NODE_URL, KAFKA_BOOTSTRAP...) do compose tự ghép
# từ các biến dưới đây; không khai báo ở đây.
HOST_A_IP=192.168.1.10
HOST_B_IP=192.168.1.20
INTERNAL_KEY=doi-khoa-nay
# Mật khẩu chỉ gồm chữ và số, không chứa @ : / ? # % (vì được ghép vào URL kết nối).
POSTGRES_PASSWORD=doimatkhaunay
# optimistic (mặc định); none chỉ dùng cho make race-unsafe
LOCK_MODE=optimistic
