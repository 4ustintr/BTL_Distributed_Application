# Sao chép thành .env trên mỗi máy và điền giá trị (spec F2). Không commit .env.
HOST_A_IP=192.168.1.10
HOST_B_IP=192.168.1.20
INTERNAL_KEY=doi-khoa-nay
POSTGRES_PASSWORD=doi-mat-khau-nay

# Node API (máy B, mỗi container một DC_ID)
DC_ID=1
NODE_DB_URL=postgresql://node_app:***@pg-dc1:5432/dc1
HQ_URL=http://192.168.1.10:8000
LOCK_MODE=optimistic

# HQ API và Consumer (máy A)
HQ_DB_URL=postgresql://hq_app:***@pg-hq:5432/hq_db
KAFKA_BOOTSTRAP=kafka:9092

# WMS (sinh vào config.js của từng container)
NODE_URL=http://192.168.1.20:8001
